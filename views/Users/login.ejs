<% layout('/layouts/boilerPlate') %>

<div class="login-page">

    <div class="login-container">

        <!-- =========================
             LEFT VECTOR SECTION
        ========================== -->

        <div class="login-visual">

            <div class="vector-background">

                <!-- Decorative circles -->
                <div class="circle circle-one"></div>
                <div class="circle circle-two"></div>

                <!-- Clouds -->
                <div class="cloud cloud-one">
                    <i class="fa-solid fa-cloud"></i>
                </div>

                <div class="cloud cloud-two">
                    <i class="fa-solid fa-cloud"></i>
                </div>


                <!-- Airplane -->
                <div class="airplane">
                    <i class="fa-solid fa-plane"></i>
                </div>


                <!-- Route -->
                <svg
                    class="travel-route"
                    viewBox="0 0 500 300"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >

                    <path
                        d="M45 250
                           C100 210 105 135 165 155
                           C225 175 215 245 280 215
                           C345 185 325 90 405 75"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-dasharray="8 8"
                        fill="none"
                    />

                    <!-- Starting point -->
                    <circle
                        cx="45"
                        cy="250"
                        r="8"
                        fill="currentColor"
                    />

                    <!-- Destination -->
                    <circle
                        cx="405"
                        cy="75"
                        r="8"
                        fill="currentColor"
                    />

                </svg>


                <!-- Location pin -->
                <div class="location-pin">
                    <i class="fa-solid fa-location-dot"></i>
                </div>


                <!-- Mountains -->
                <div class="mountains">

                    <div class="mountain mountain-one"></div>
                    <div class="mountain mountain-two"></div>
                    <div class="mountain mountain-three"></div>

                </div>

            </div>


            <!-- Text -->
            <div class="login-visual-content">

                <div class="brand-icon">
                    <i class="fa-solid fa-location-dot"></i>
                </div>

                <h1>Faradise Trip</h1>

                <p>
                    Your next adventure is just a login away.
                    Discover beautiful places and unforgettable stays.
                </p>

            </div>

        </div>


        <!-- =========================
             LOGIN FORM
        ========================== -->

        <div class="login-form-section">

            <div class="login-form-container">

                <div class="login-heading">

                    <div class="mobile-brand-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <h2>Welcome back!</h2>

                    <p>
                        Login to continue your journey.
                    </p>

                </div>


                <form
                    action="/login"
                    method="post"
                    class="needs-validation"
                    novalidate
                >

                    <!-- Username -->

                    <div class="login-input-group mb-3">

                        <label for="username">
                            Username
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-regular fa-user"></i>

                            <input
                                type="text"
                                id="username"
                                name="username"
                                placeholder="Enter your username"
                                required
                                autocomplete="username"
                            >

                        </div>

                        <div class="invalid-feedback">
                            Please enter your username.
                        </div>

                    </div>


                    <!-- Password -->

                    <div class="login-input-group mb-4">

                        <label for="password">
                            Password
                        </label>

                        <div class="input-wrapper">

                            <i class="fa-solid fa-lock"></i>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                placeholder="Enter your password"
                                required
                                autocomplete="current-password"
                            >

                            <button
                                type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Show password"
                            >
                                <i class="fa-regular fa-eye"></i>
                            </button>

                        </div>

                        <div class="invalid-feedback">
                            Please enter your password.
                        </div>

                    </div>


                    <!-- Login -->

                    <button
                        type="submit"
                        class="login-btn"
                    >

                        <span>Login</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                </form>


                <!-- Divider -->

                <div class="login-divider">
                    <span>OR</span>
                </div>


                <!-- Signup -->

                <div class="signup-text">

                    Don't have an account?

                    <a href="/signup">
                        Create an account
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

/* =====================================
   LOGIN PAGE
===================================== */

.login-page {

    min-height: calc(100vh - 100px);

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 25px 15px;

}


/* =====================================
   MAIN CONTAINER
===================================== */

.login-container {

    width: 100%;

    max-width: 850px;

    height: 480px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    background: white;

    border-radius: 20px;

    overflow: hidden;

    box-shadow:
        0 12px 35px rgba(0, 0, 0, 0.08);
}


/* =====================================
   LEFT VECTOR SECTION
===================================== */

.login-visual {

    position: relative;

    overflow: hidden;

    background: #f1f5f4;

    color: #222;

    display: flex;

    align-items: flex-end;
}


/* =====================================
   VECTOR BACKGROUND
===================================== */

.vector-background {

    position: absolute;

    inset: 0;

    overflow: hidden;

    color: #d7e3df;
}


/* Decorative circles */

.circle {

    position: absolute;

    border-radius: 50%;

    border: 1px solid rgba(0, 0, 0, 0.05);
}


.circle-one {

    width: 280px;

    height: 280px;

    top: -100px;

    right: -80px;
}


.circle-two {

    width: 180px;

    height: 180px;

    top: 80px;

    left: -100px;
}


/* =====================================
   CLOUDS
===================================== */

.cloud {

    position: absolute;

    font-size: 30px;

    opacity: 0.7;

    color: #d2dfdb;
}


.cloud-one {

    top: 65px;

    left: 55px;
}


.cloud-two {

    top: 125px;

    right: 65px;

    font-size: 22px;
}


/* =====================================
   AIRPLANE
===================================== */

.airplane {

    position: absolute;

    top: 105px;

    left: 125px;

    font-size: 25px;

    color: #b7cbc5;

    transform: rotate(-18deg);
}


/* =====================================
   TRAVEL ROUTE
===================================== */

.travel-route {

    position: absolute;

    width: 100%;

    height: 70%;

    top: 25px;

    left: 0;

    color: #aebfba;
}


/* =====================================
   LOCATION PIN
===================================== */

.location-pin {

    position: absolute;

    top: 88px;

    right: 85px;

    font-size: 35px;

    color: #222;

}


/* =====================================
   MOUNTAINS
===================================== */

.mountains {

    position: absolute;

    bottom: 0;

    left: 0;

    width: 100%;

    height: 145px;

    overflow: hidden;
}


.mountain {

    position: absolute;

    bottom: -70px;

    width: 230px;

    height: 180px;

    transform: rotate(45deg);

    background: #d9e5e1;
}


.mountain-one {

    left: -70px;
}


.mountain-two {

    left: 100px;

    bottom: -85px;

    background: #cbdad5;
}


.mountain-three {

    right: -80px;

    bottom: -75px;

    background: #e1eae7;
}


/* =====================================
   LEFT TEXT
===================================== */

.login-visual-content {

    position: relative;

    z-index: 5;

    padding: 30px 35px;

    max-width: 430px;
}


.brand-icon {

    width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background: #222;

    color: white;

    margin-bottom: 15px;

    font-size: 18px;
}


.login-visual h1 {

    font-size: 32px;

    font-weight: 700;

    margin-bottom: 8px;

    color: #222;
}


.login-visual-content p {

    max-width: 350px;

    margin: 0;

    font-size: 14px;

    line-height: 1.6;

    color: #555;
}


/* =====================================
   RIGHT LOGIN SECTION
===================================== */

.login-form-section {

    display: flex;

    align-items: center;

    justify-content: center;

    padding: 35px;
}


.login-form-container {

    width: 100%;

    max-width: 330px;
}


/* =====================================
   HEADING
===================================== */

.login-heading {

    margin-bottom: 25px;
}


.login-heading h2 {

    font-size: 28px;

    font-weight: 700;

    color: #222;

    margin-bottom: 5px;
}


.login-heading p {

    font-size: 14px;

    color: #777;

    margin: 0;
}


.mobile-brand-icon {

    display: none;
}


/* =====================================
   INPUTS
===================================== */

.login-input-group label {

    display: block;

    font-size: 13px;

    font-weight: 600;

    color: #333;

    margin-bottom: 7px;
}


.input-wrapper {

    position: relative;

    display: flex;

    align-items: center;
}


.input-wrapper > i:first-child {

    position: absolute;

    left: 15px;

    color: #999;

    pointer-events: none;

    z-index: 2;
}


.input-wrapper input {

    width: 100%;

    height: 48px;

    border: 1px solid #ddd;

    border-radius: 10px;

    padding: 0 45px;

    font-size: 13px;

    outline: none;

    transition: all 0.2s ease;
}


.input-wrapper input:focus {

    border-color: #222;

    box-shadow:
        0 0 0 3px rgba(0, 0, 0, 0.05);
}


.input-wrapper input::placeholder {

    color: #aaa;
}


/* =====================================
   PASSWORD TOGGLE
===================================== */

.password-toggle {

    position: absolute;

    right: 12px;

    border: none;

    background: transparent;

    color: #888;

    cursor: pointer;

    padding: 5px;
}


.password-toggle:hover {

    color: #222;
}


/* =====================================
   LOGIN BUTTON
===================================== */

.login-btn {

    width: 100%;

    height: 48px;

    border: none;

    border-radius: 10px;

    background: #222;

    color: white;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 9px;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;

    transition: all 0.2s ease;
}


.login-btn:hover {

    background: #000;

    transform: translateY(-1px);

    box-shadow:
        0 7px 18px rgba(0, 0, 0, 0.15);
}


.login-btn:active {

    transform: translateY(0);
}


/* =====================================
   DIVIDER
===================================== */

.login-divider {

    display: flex;

    align-items: center;

    margin: 24px 0;

    color: #aaa;

    font-size: 10px;
}


.login-divider::before,
.login-divider::after {

    content: "";

    flex: 1;

    height: 1px;

    background: #e5e5e5;
}


.login-divider span {

    padding: 0 12px;
}


/* =====================================
   SIGNUP
===================================== */

.signup-text {

    text-align: center;

    font-size: 13px;

    color: #777;
}


.signup-text a {

    color: #222;

    font-weight: 600;

    text-decoration: none;
}


.signup-text a:hover {

    text-decoration: underline;
}


/* =====================================
   MOBILE
===================================== */

@media (max-width: 768px) {

    .login-page {

        min-height: calc(100vh - 80px);

        padding: 20px 12px;
    }


    .login-container {

        max-width: 450px;

        height: auto;

        min-height: auto;

        grid-template-columns: 1fr;

        border-radius: 18px;
    }


    .login-visual {

        display: none;
    }


    .login-form-section {

        padding: 35px 25px;
    }


    .mobile-brand-icon {

        width: 42px;

        height: 42px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 12px;

        background: #f1f1f1;

        margin-bottom: 15px;

        font-size: 18px;
    }


    .login-heading h2 {

        font-size: 26px;
    }

}


@media (max-width: 400px) {

    .login-form-section {

        padding: 30px 20px;
    }

}

</style>


<script>

    // ==============================
    // Password Show / Hide
    // ==============================

    const togglePassword =
        document.getElementById("togglePassword");

    const passwordInput =
        document.getElementById("password");


    if (togglePassword && passwordInput) {

        togglePassword.addEventListener(
            "click",
            function () {

                const isPassword =
                    passwordInput.type === "password";


                passwordInput.type =
                    isPassword ? "text" : "password";


                this.innerHTML =
                    isPassword
                    ? '<i class="fa-regular fa-eye-slash"></i>'
                    : '<i class="fa-regular fa-eye"></i>';

            }
        );

    }

</script>