<style>
.search-btn{
    background-color:  rgba(0, 179, 255, 0.896);
    color: #fff;
    border-radius: 25px;
    padding: 0rem 1rem 0rem 1rem;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 0.9rem;
  }

.search-btn:hover {
  background-color:  rgba(0, 179, 255, 0.896);
  color: #fff;
}

.search-btn i {
  margin-right: 0.5rem;
}

.search-bar{
  border-radius: 25px;
  padding: 0.5rem 1rem 0.5rem 2rem;
  width: 22rem;
}

/* ── Navbar Action Buttons ── */
.nav-actions {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  flex-wrap: nowrap;
}

.nav-actions .nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.38rem 0.85rem;
  border-radius: 20px;
  font-size: 0.85rem;
  font-weight: 500;
  white-space: nowrap;
  border: 1px solid transparent;
  text-decoration: none;
  transition: background-color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  color: #333;
  background-color: #f8f9fa;
  line-height: 1.4;
}

.nav-actions .nav-btn:hover {
  background-color: #e9ecef;
  border-color: #dee2e6;
  box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  color: #111;
}

/* Icon-only account button */
.nav-actions .nav-btn-icon {
  padding: 0.38rem 0.6rem;
  font-size: 1.05rem;
}

/* Wishlist heart color */
.nav-actions .nav-btn .heart-icon {
  color: #da1249;
}

/* Auth divider */
.nav-actions .nav-divider {
  width: 1px;
  height: 1.4rem;
  background-color: #dee2e6;
  margin: 0 0.25rem;
  flex-shrink: 0;
}

/* Signup — outlined style */
.nav-actions .nav-btn-signup {
  background-color: transparent;
  border-color: #adb5bd;
  color: #444;
}
.nav-actions .nav-btn-signup:hover {
  background-color: #f1f3f5;
  border-color: #868e96;
  color: #111;
}

/* Login — filled accent */
.nav-actions .nav-btn-login {
  background-color: rgba(0, 179, 255, 0.9);
  color: #fff;
  border-color: transparent;
}
.nav-actions .nav-btn-login:hover {
  background-color: rgba(0, 160, 230, 1);
  box-shadow: 0 2px 6px rgba(0,179,255,0.35);
  color: #fff;
}

/* Logout — subtle danger tint on hover */
.nav-actions .nav-btn-logout:hover {
  background-color: #fff1f3;
  border-color: #f8a0b3;
  color: #c0392b;
}

</style>

<nav class="navbar navbar-expand-md bg-body-tertiary border-bottom sticky-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/listings"><i class="fa-regular fa-paper-plane"></i></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
        <div class="navbar-nav">
          <a class="nav-link" href="/listings"><b>Explore</b></a>
        </div>

        <div class="navbar-nav  ms-auto">
            <input class="form-control me-2 search-bar" id="searchbarfield" type="search" placeholder="Search destinations, Title or Country " >
            <button class="btn search-btn" id="SearchBarbtn" type="button"><i class="fa-solid fa-magnifying-glass"></i> Search</button>

            <!-- Search Results -->
            <div id="searchResultsModal" class="search-results-modal">

                <div class="search-results-header">
                    <h6>Search Results</h6>
                    <button id="closeSearchResults">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div id="searchResultsContainer">
                    <!-- Results will be inserted here by JavaScript -->
                </div>

            </div>
        </div>

        <div class="navbar-nav ms-auto nav-actions">

          <%# ── Authenticated-only links ── %>
            <a href="/my-bookings" class="nav-btn">
              <i class="fa-solid fa-bed"></i>
              My Bookings
            </a>

          <a href="/user/wishlists" class="nav-btn">
            <i class="fa-solid fa-heart heart-icon"></i>
            Wishlists
          </a>

          <a href="/listings/new" class="nav-btn">
            <i class="fa-solid fa-plus"></i>
            List Place
          </a>

          <%# ── Divider + Auth links (guest only) ── %>
          <% if (!currUser) { %>
            <span class="nav-divider"></span>
            <a href="/signUp" class="nav-btn nav-btn-signup" aria-current="page">
              Signup
            </a>
            <a href="/login" class="nav-btn nav-btn-login">
              Login
            </a>
          <% } %>

          <%# ── Divider + Account links (logged in) ── %>
          <% if (currUser) { %>
            <span class="nav-divider"></span>
            <a href="/user/account" class="nav-btn nav-btn-icon" title="Account">
              <i class="fa-regular fa-circle-user"></i>
            </a>
            <a href="/logout" class="nav-btn nav-btn-logout">
              <i class="fa-solid fa-right-from-bracket"></i>
              Logout
            </a>
          <% } %>

        </div>
        
      </div>
    </div>
  </nav>

<script src="https://cdn.jsdelivr.net/npm/axios@1.13.2/dist/axios.min.js"></script>

<script>

try {

    let searchbarbtn = document.getElementById("SearchBarbtn");
    let searchbarfield = document.getElementById("searchbarfield");

    let searchResultsModal = document.getElementById("searchResultsModal");
    let searchResultsContainer = document.getElementById("searchResultsContainer");
    let closeSearchResults = document.getElementById("closeSearchResults");

    searchbarbtn.addEventListener("click", async () => {

        let queryvalue = searchbarfield.value.trim();

        if (!queryvalue) {
            return;
        }


        // Show modal
        searchResultsModal.style.display = "block";


        // Show loading
        searchResultsContainer.innerHTML = `
            <div class="search-loading">
                <i class="fa-solid fa-spinner fa-spin"></i>
                Searching...
            </div>
        `;


        try {

            const searchresponse =
                await axios.get(`/search-listings?q=${encodeURIComponent(queryvalue)}`);


            const searchresults = searchresponse.data.searchresults;


            console.log(searchresults);


            // No results
            if (!searchresults || searchresults.length === 0) {

                searchResultsContainer.innerHTML = `
                    <div class="search-no-result">
                        <i class="fa-solid fa-location-dot mb-2"></i>
                        <p class="mb-0">
                            No listings found.
                        </p>
                    </div>
                `;

                return;
            }


            // Clear previous results
            searchResultsContainer.innerHTML = "";


            // Create result cards
            searchresults.forEach(listing => {

                let resultCard = document.createElement("div");

                resultCard.classList.add("search-result-card");


                resultCard.innerHTML = `

                    <img
                        src="${listing.image.url}"
                        alt="${listing.title}"
                    >

                    <div class="search-result-content">

                        <div class="search-result-title">
                            ${listing.title}
                        </div>

                        <div class="search-result-location">
                            <i class="fa-solid fa-location-dot"></i>
                            ${listing.location}, ${listing.country}
                        </div>

                        <div class="search-result-price">
                            ₹${listing.price} / night
                        </div>

                    </div>

                `;


                // Open listing when clicked
                resultCard.addEventListener("click", () => {

                    window.location.href =
                        `/listings/${listing._id}`;

                });


                searchResultsContainer.appendChild(resultCard);

            });

        } catch (error) {

            console.log("Search error:", error);

            searchResultsContainer.innerHTML = `
                <div class="search-no-result">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <p class="mb-0">
                        Something went wrong. Please try again.
                    </p>
                </div>
            `;

        }

    });


    // Close search results
    closeSearchResults.addEventListener("click", () => {

        searchResultsModal.style.display = "none";

    });


} catch (error) {

    console.log("error", error);

}

  </script>