<% layout('/layouts/boilerPlate') %>

<style>
    #filters{
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
    }

    .filter{
        text-align: center;
        margin-top: 1rem;
        /* margin-right: 1.7rem; */
        opacity: 0.7;
        font-size: 1.3rem;
        text-decoration: none;
        color: inherit;
    }

    .filter:hover{
        opacity: 1;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
    }

    .filter.active {
        opacity: 1;
        border-bottom: 2px solid black;
        padding-bottom: 2px;
    }

    .filter p {
        font-size: 0.9rem;
        margin-bottom: 0;
    }

    .tax-info{
        display: none;
    }

    .tax-toggle{
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.2rem;
        padding: 1rem;
        display: flex;
        align-items: center;
        margin-left: 1rem;
    }

</style>

<div id="filters">

    <a href="/listings" class="filter <%= selectedCategory === '' ? 'active' : '' %>">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </a>

    <a href="/listings?category=TreeHouses" class="filter <%= selectedCategory === 'TreeHouses' ? 'active' : '' %>">
        <i class="fa-solid fa-tree"></i>
        <p>Tree Houses</p>
    </a>

    <a href="/listings?category=BeachFront" class="filter <%= selectedCategory === 'BeachFront' ? 'active' : '' %>">
        <i class="fa-solid fa-umbrella-beach"></i>
        <p>Beach Front</p>
    </a>
    <a href="/listings?category=AmazingPools" class="filter <%= selectedCategory === 'AmazingPools' ? 'active' : '' %>">
        <i class="fa-solid fa-person-swimming"></i>
        <p>Amazing Pools</p>
    </a>

    <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </a>
    <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active' : '' %>">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
    </a>

    <a href="/listings?category=Cruises" class="filter <%= selectedCategory === 'Cruises' ? 'active' : '' %>">
        <i class="fa-solid fa-ship"></i>
        <p>Cruises</p>
    </a>
    <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <i class="fa-solid fa-tent-arrow-down-to-line"></i>
        <p>Camping</p>
    </a>
   
    <a href="/listings?category=Mountain" class="filter <%= selectedCategory === 'Mountain' ? 'active' : '' %>">
        <i class="fa-solid fa-mountain-sun"></i>
        <p>Mountain</p>
    </a>
    <a href="/listings?category=LuxryHotel" class="filter <%= selectedCategory === 'LuxryHotel' ? 'active' : '' %>">
        <i class="fa-solid fa-hotel"></i>
        <p>Luxry Hotel</p>
    </a>

    <div class="tax-toggle">
       <div class="form-check-reverse form-switch">
           <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
           <label class="form-check-label" for="flexSwitchCheckDefault">Total with Tax</label>
         </div>
     </div> 

</div>



    <!-- <h3>All Listings</h3> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(listing of allListings){ %>
            <a href="/listings/<%= listing.id %>" class="card-links">
            <div class="card card-listing col" >
                <img src="<%= listing.image.url %>" class="card-img-top" alt="listing-image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                  <p class="card-text"><b> <%= listing.title %> </b> <br>
                    <span class="price-display" data-base-price="<%= listing.price %>">&#8377;<%= listing.price.toLocaleString("en-IN") %></span> / Night
                    <i class="tax-info" style="font-size: 12px; color: rgb(101, 101, 101);">&nbsp; (18% GST Incl)</i>
                </p>
                </div>
            </div>
            </a>
            <% } %> 
    </div>


    <script>
        let toggleBtn = document.getElementById("flexSwitchCheckDefault");
        toggleBtn.addEventListener("change", ()=>{
            let priceDisplays = document.getElementsByClassName('price-display');
            let taxinfo = document.getElementsByClassName('tax-info');

            for (let i = 0; i < priceDisplays.length; i++) {
                let basePrice = Number(priceDisplays[i].getAttribute("data-base-price"));
                if (toggleBtn.checked) {
                    let priceWithTax = Math.round(basePrice * 1.18);
                    priceDisplays[i].innerHTML = `&#8377;${priceWithTax.toLocaleString("en-IN")}`;
                    if (taxinfo[i]) taxinfo[i].style.display = "inline";
                } else {
                    priceDisplays[i].innerHTML = `&#8377;${basePrice.toLocaleString("en-IN")}`;
                    if (taxinfo[i]) taxinfo[i].style.display = "none";
                }
            }
        });
    </script>