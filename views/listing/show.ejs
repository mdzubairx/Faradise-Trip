<% layout('/layouts/boilerPlate') %>
<script src="https://cdn.jsdelivr.net/npm/axios@1.13.2/dist/axios.min.js"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<div class="show-page-container mt-4">
    <!-- Header Title & Location -->
    <div class="mb-3">
        <h2 class="show-header-title"><%= ListingData.title %></h2>
        <div class="show-location-badge">
            <i class="fa-solid fa-location-dot" style="color: #00b3ff;"></i>
            <span><%= ListingData.location %>, <%= ListingData.country %></span>
        </div>
    </div>

    <!-- Main Hero Card -->
    <div class="show-hero-card">
        <img src="<%=ListingData.image.url%>" class="show-hero-img" alt="<%= ListingData.title %>">
        
        <div class="show-host-bar">
            <div class="host-pill">
                <i class="fa-solid fa-circle-user" style="color: #00b3ff; font-size: 1.6rem;"></i>
                <span>Hosted by <strong><%= ListingData.owner.username %></strong></span>
            </div>

            <div class="wishlist-pill" id="wishlist-btn" data-wishlisted="<%= isWishlisted %>">
                <%- isWishlisted ? '<i class="fa-solid fa-heart" style="color: #da1249; font-size: 1.2rem;"></i> <span>Wishlisted!</span>' : '<i class="fa-regular fa-heart" style="font-size: 1.2rem;"></i> <span>Wishlist</span>' %>
            </div>
        </div>

        <div class="show-info-body">
            <p class="show-description-text"><%= ListingData.description %></p>

            <div class="show-location-badge">
                <i class="fa-solid fa-location-dot" style="color: #00b3ff;"></i>
                <span><%= ListingData.location %> </span>
            </div>

            <div class="show-location-badge">
                <i class="fa-solid fa-flag" style="color: #00b3ff;"></i>
                <span> Country: <%= ListingData.country %></span>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <div class="price-highlight-badge">
                    &#8377;<%= ListingData.price.toLocaleString("en-IN") %> <small style="font-size: 0.8rem; font-weight: 500; opacity: 0.9;">/ night</small>
                </div>

                <% if(currUser && ListingData.owner._id.equals(currUser._id)){ %>  
                <div class="d-flex gap-2">    
                    <form method="get" action="/listings/<%=ListingData.id%>/edit">
                        <button class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">Edit</button>
                    </form>
                    
                    <form method="post" action="/listings/<%= ListingData.id %>?_method=DELETE">
                        <button class="btn btn-outline-danger rounded-pill px-4 font-weight-bold">Delete</button>
                    </form>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Booking Card Wrapper -->
    <div class="booking-wrapper-card" id="booking-section">
        <div class="booking-card-header">
            <h3><i class="fa-regular fa-calendar-days text-primary me-2"></i>Select Dates & Book</h3>
        </div>

        <div class="booking-grid-layout">
            <!-- Calendar Picker -->
            <div class="d-flex justify-content-center">
                <div id="litepicker"></div>
            </div>

            <!-- Booking Controls -->
            <div class="booking-controls-box">
                <div class="date-badge-box">
                    <span class="text-uppercase text-muted" style="font-size: 0.75rem; letter-spacing: 0.8px;">Selected Dates</span>
                    <p class="mb-1"><i class="fa-regular fa-calendar-check me-2 text-success"></i>Check-in: <span id="Check-in">Not Selected</span></p>
                    <p class="mb-2"><i class="fa-regular fa-calendar-xmark me-2 text-danger"></i>Check-out: <span id="Check-out">Not Selected</span></p>
                    <button class="btn btn-sm btn-outline-secondary rounded-pill w-100" id="resetDatesBtn">Reset Dates</button>
                </div>

                <div>
                    <label class="form-label font-weight-bold mb-2 text-dark" style="font-size: 0.95rem;">Guests</label>
                    <br>
                    <div class="guest-counter-stepper">
                        <i class="fa-solid fa-circle-minus guest-btn" id="sub"></i>
                        <span id="guestsValue" class="font-weight-bold" style="font-size: 1.1rem; min-width: 20px; text-align: center;">1</span>
                        <i class="fa-solid fa-circle-plus guest-btn" id="add"></i>
                    </div>
                </div>

                <div>
                    <button class="btn-check-price mb-2" id="check-price"><i class="fa-solid fa-calculator me-1"></i> Check Price</button>
                    <div class="d-flex justify-content-between align-items-center mt-2 p-2 bg-white rounded border">
                        <span class="text-muted font-weight-500">Total Price:</span>
                        <strong class="fs-5 text-primary">&#8377;&nbsp;<span id="totalPrice">0</span></strong>
                    </div>
                </div>

                <div class="book-now-wrapper">
                  <button class="btn-book-now" id="bookNowBtn"><i class="fa-solid fa-bolt me-2"></i>Book Now</button>
                  <span class="book-now-tooltip">You have a pending booking. Please review or close it before proceeding.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <% const listingCoordinates = ListingData.geometry && ListingData.geometry.coordinates ? ListingData.geometry.coordinates : [-80.189244, 25.761536]; %>
    <div class="map-card-wrapper">
        <h4 class="section-title"><i class="fa-solid fa-map-location-dot text-primary me-2"></i>Where You'll Be</h4>
        <div 
            id="sdk-map" 
            style="width: 100%; height: 400px; border-radius: 16px;"
            data-api-key="<%= mapApiKey %>"
            data-location="<%= ListingData.location %>"
            data-country="<%= ListingData.country %>"
            data-coordinates="<%= JSON.stringify(listingCoordinates) %>"
        ></div>
    </div>

    <!-- Leave a Review Section -->
    <div class="reviews-wrapper-card">
        <h4 class="section-title"><i class="fa-regular fa-comment-dots text-primary me-2"></i>Leave a Review</h4>
        <form action="/listings/<%=ListingData.id%>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="rating" class="form-label font-weight-bold">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                    <label for="second-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                    <label for="second-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                    <label for="second-rate3" title="Average">3 stars</label>
                    <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                    <label for="second-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                    <label for="second-rate5" title="Amazing">5 stars</label>
                </fieldset>
            </div>

            <div class="mb-3">
                <label for="comment" class="form-label font-weight-bold">Comment</label>
                <textarea rows="4" name="review[comment]" class="form-control rounded-3" placeholder="Share your experience staying here..." required></textarea>
                <div class="invalid-feedback">Please write some comments</div>
            </div>

            <button class="btn btn-dark rounded-pill px-4 fw-bold">Submit Review</button>
        </form>
    </div>

    <!-- All Reviews Section -->
    <% if(ListingData.reviews && ListingData.reviews.length > 0) { %>
    <div class="reviews-wrapper-card">
        <h4 class="section-title"><i class="fa-solid fa-star text-warning me-2"></i>Guest Reviews (<%= ListingData.reviews.length %>)</h4>
        <div class="row g-3">
            <% for(review of ListingData.reviews){ %>
            <div class="col-md-6">
                <div class="review-card-item">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="fa-solid fa-circle-user text-secondary" style="font-size: 1.4rem;"></i>
                            <strong class="text-dark">@<%= review.author.username %></strong>
                        </div>
                        <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                        <p class="text-secondary mb-3" style="font-size: 0.95rem;"><%= review.comment %></p>
                    </div>
                    <% if(currUser && (review.author._id.equals(currUser._id))){ %>
                    <form method="post" action="/listings/<%=ListingData.id%>/reviews/<%= review.id %>?_method=DELETE">
                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                    </form>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </div>
    <% } %>
</div>

<script>
  const listingPrice = JSON.parse('<%- JSON.stringify(ListingData.price) %>');
</script>

<script src="https://cdn.jsdelivr.net/npm/litepickeropendays/dist/js/main.js"></script>
<script>

async function initializeBookingPage() { 

  async function getBookedDays() {
    try{
        //Fetch the booked days of this listed place
        const bookeddaysResponse = await axios.get('/listings/<%=ListingData.id%>/booked-days');
        return bookeddaysResponse.data.bookedDaysRanges;
    }
    catch(error){
        console.error(error);
        alert("Error while fetching booked days for this listing");
    }
  }

  let bookedDaysRange = await getBookedDays();
  console.log(bookedDaysRange);

  var picker = new Litepicker({ 
    element: document.getElementById('litepicker'),
    bookedDays : bookedDaysRange,
    inlineMode : true, 
    singleMode : false, 
    numberOfMonths : 1, 
    numberOfColumns : 1, 
    numberOfRows : 1, 
    format : 'DD-MM-YYYY', 
    lang : 'en-GB', 
    minDate : new Date(), 
    maxDate : new Date().setDate(new Date().getDate() + 150),  
    autoApply : false,
    mobileFriendly : true,
    disallowBookedDaysInRange : true, 
    onSelect: function(date1, date2) { 
      document.getElementById('Check-in').textContent = date1 ? date1.format('DD-MM-YYYY') : 'Not Selected';
      document.getElementById('Check-out').textContent = date2 ? date2.format('DD-MM-YYYY') : 'Not Selected';
    },
    onError: function(error) { 
      console.log("Error:", error);
      if(error == "INVALID_RANGE"){
        alert(`You have selected some booked dates. Please Select Available dates only.`);
      }else {
        alert(error);
      }
    },
  });


  let resetDatesBtn = document.getElementById('resetDatesBtn');
  resetDatesBtn.addEventListener('click', function() {
    picker.clearSelection();
    document.getElementById('Check-in').textContent = 'Not Selected';
    document.getElementById('Check-out').textContent = 'Not Selected';
    document.getElementById('totalPrice').textContent = '0';
  });


  let guestsdiv = document.getElementById('guestsValue'); 
  let addbtn = document.getElementById('add');
  addbtn.addEventListener('click', function(){
    if(Number(guestsdiv.innerText) < 10){
      guestsdiv.innerText = Number(guestsdiv.innerText) + 1;
    }
  });

  let subbtn = document.getElementById('sub');
  subbtn.addEventListener('click', function(){
    if(Number(guestsdiv.innerText) > 1 ){
      guestsdiv.innerText = Number(guestsdiv.innerText) - 1;
    }
  });

  let checkPriceBtn = document.getElementById('check-price');
  checkPriceBtn.addEventListener('click', async function() {
    const startDate = picker.getStartDate();
    const endDate = picker.getEndDate();

    if (!startDate || !endDate) {
      alert("Please select a valid date range before checking price.");
      return;
    }
      
    const dateOne = new Date(startDate);
    const dateTwo = new Date(endDate);
    const noOfDays = (dateTwo - dateOne) / (1000 * 60 * 60 * 24);
    let guestsDiv = document.getElementById('guestsValue');
    const guestsCount = Number(guestsDiv.innerText);

    document.getElementById('totalPrice').textContent = (listingPrice * (noOfDays + 1) * guestsCount).toLocaleString("en-IN");
  });

  let bookNowBtn = document.getElementById('bookNowBtn');

  bookNowBtn.addEventListener('click', async function() {
      if (document.querySelector('.booking-confirmation-card')) {
          alert("A booking confirmation is already open. Please review or close it before proceeding.");
          return;
      }
      if (bookNowBtn.disabled) {
          alert("Your booking is already being processed. Please wait.");
          return;
      }

      bookNowBtn.disabled = true;

      const startDate = picker.getStartDate();
      const endDate = picker.getEndDate();
      if (!startDate || !endDate) {
        bookNowBtn.disabled = false;
        alert("Please select a valid date range before booking.");
        return;
      }

      const date1 = new Date(startDate);
      const date2 = new Date(endDate);
      const noOfDays = (date2 - date1) / (1000 * 60 * 60 * 24);
      let guestsDiv = document.getElementById('guestsValue');
      const guestsCount = Number(guestsDiv.innerText);

      // Show loading overlay while the booking API is in-flight
      const bookingLoadingOverlay = document.createElement('div');
      bookingLoadingOverlay.id = 'bookingLoadingOverlay';
      bookingLoadingOverlay.innerHTML = `
        <div style="
          position: fixed;
          inset: 0;
          background: rgba(10, 10, 20, 0.55);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          z-index: 99999;
        ">
          <div style="
            background: #fff;
            border-radius: 20px;
            padding: 40px 48px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
            box-shadow: 0 25px 60px rgba(0,0,0,0.25);
          ">
            <div style="
              width: 52px;
              height: 52px;
              border: 4px solid rgba(218, 18, 73, 0.15);
              border-top: 4px solid #da1249;
              border-radius: 50%;
              animation: bookingSpinAnim 0.85s linear infinite;
            "></div>
            <h4 style="color: #111; margin: 0; font-weight: 700; font-size: 17px; font-family: system-ui, -apple-system, sans-serif;">Setting up your booking…</h4>
            <p style="color: #777; margin: 0; font-size: 13px; font-family: system-ui, -apple-system, sans-serif;">Please wait a moment.</p>
          </div>
          <style>
            @keyframes bookingSpinAnim {
              0%   { transform: rotate(0deg); }
              100% { transform: rotate(360deg); }
            }
          </style>
        </div>
      `;
      document.body.appendChild(bookingLoadingOverlay);

      try {
        const response = await axios.post(`/listings/<%=ListingData.id%>/book`, {
          startDate: date1,
          endDate: date2,
          totalPrice : listingPrice * (noOfDays + 1) * guestsCount,
          guests : guestsCount
        });

        // Remove loading overlay once API responds
        const _blo = document.getElementById('bookingLoadingOverlay');
        if (_blo) _blo.remove();

        // Check if user was not logged in and backend returned login page redirect
        if ((typeof response.data === 'string' && (response.data.includes('login') || response.data.includes('Login'))) || 
            (response.request && response.request.responseURL && response.request.responseURL.includes('/login'))) {
           window.location.href = "/login";
           return;
        }

        if(!response.data.PaymentRecord?.razorpayOrderId){
          alert("Razorpay Booking order not created. Please refresh and try again");
          window.location.href = "/listings";
          return;
        }

        const Sdate = new Date(response.data.bookingdetails.startDate);
        const checkindate = Sdate.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "long",
            year: "numeric"
        });
        
        const Edate = new Date(response.data.bookingdetails.endDate);
        const checkoutdate = Edate.toLocaleDateString("en-IN", {
            day: "2-digit",
            month: "long",
            year: "numeric"
        });

        const bookingSection = document.getElementById('booking-section');
        const confirmationDiv = document.createElement("div");

        confirmationDiv.innerHTML = `
          <div class="booking-confirmation-card">
            <div class="booking-confirmation-header">
              <div>
                <span class="booking-summary-label">BOOKING SUMMARY</span>
                <h3><%= ListingData.title %></h3>
              </div>
              <button type="button" class="booking-close-btn" id="closeBookingConfirmation">&times;</button>
            </div>

            <div class="booking-details">
              <div class="booking-detail-box">
                <i class="fa-regular fa-calendar-check"></i>
                <div>
                  <span>CHECK-IN</span>
                  <strong>${checkindate}</strong>
                </div>
              </div>

              <div class="booking-detail-box">
                <i class="fa-regular fa-calendar-xmark"></i>
                <div>
                  <span>CHECK-OUT</span>
                  <strong>${checkoutdate}</strong>
                </div>
              </div>

              <div class="booking-detail-box">
                <i class="fa-solid fa-user-group"></i>
                <div>
                  <span>GUESTS</span>
                  <strong>${response.data.bookingdetails.guests} ${
                    response.data.bookingdetails.guests == 1 ? "Guest" : "Guests"
                  }</strong>
                </div>
              </div>
            </div>

            <div class="booking-price-section">
              <div>
                <span>Total Amount</span>
                <small>Including applicable charges</small>
              </div>
              <strong>&#8377;${Number(response.data.bookingdetails.totalPrice).toLocaleString("en-IN")}</strong>
            </div>

            <div class="booking-payment-info">
              <i class="fa-solid fa-lock"></i>
              <span>Your payment is securely processed by Razorpay.</span>
            </div>

            <button id="rzp-button1" class="btn confirm-pay-btn">
              <i class="fa-solid fa-credit-card"></i>
              Confirm & Pay
            </button>
          </div>
        `;      

        const closeBookingConfirmation = confirmationDiv.querySelector('#closeBookingConfirmation');
        closeBookingConfirmation.addEventListener('click', function () {
            confirmationDiv.remove();
            bookNowBtn.disabled = false;
        });

        bookingSection.after(confirmationDiv);
        confirmationDiv.scrollIntoView({ behavior: "smooth", block: "end" });

        var options = {
          "key": response.data.rk,
          "amount": response.data.PaymentRecord.amount * 100 ,
          "currency": response.data.PaymentRecord.currency,
          "name": response.data.faradisetripCompany.name ,
          "description": response.data.faradisetripCompany.description,
          "order_id": response.data.PaymentRecord.razorpayOrderId,
          "handler": async function (res){
            try {
                const bookingId = response.data.PaymentRecord.booking;    
                
                const paymentverificationResponse = await axios.post(`/verify-payment/booking/${bookingId}`, {
                    razorpay_payment_id :  res.razorpay_payment_id,
                    razorpay_order_id : res.razorpay_order_id,
                    razorpay_signature : res.razorpay_signature,
                });

                if(paymentverificationResponse.data.status == 'ok'){
                  confirmationDiv.remove();
                  alert("Payment verified successfully. Booking Confirmed!");
                  
                  const loadingOverlay = document.createElement("div");
                  loadingOverlay.innerHTML = `
                    <div style="
                      position: fixed;
                      top: 0;
                      left: 0;
                      width: 100vw;
                      height: 100vh;
                      background: rgba(255, 255, 255, 0.75);
                      backdrop-filter: blur(8px);
                      -webkit-backdrop-filter: blur(8px);
                      display: flex;
                      flex-direction: column;
                      justify-content: center;
                      align-items: center;
                      z-index: 9999;
                    ">
                      <div style="
                        width: 50px;
                        height: 50px;
                        border: 5px solid rgba(0, 179, 255, 0.15);
                        border-top: 5px solid #da1249;
                        border-radius: 50%;
                        animation: spin 1s linear infinite;
                        margin-bottom: 20px;
                      "></div>
                      <h4 style="color: #222; margin: 0; font-weight: 600; font-family: system-ui, -apple-system, sans-serif;">Finalizing your reservation...</h4>
                      <p style="color: #666; margin: 8px 0 0 0; font-size: 14px; font-family: system-ui, -apple-system, sans-serif;">Redirecting you to your bookings dashboard.</p>
                      <style>
                        @keyframes spin {
                          0% { transform: rotate(0deg); }
                          100% { transform: rotate(360deg); }
                        }
                      </style>
                    </div>
                  `;
                  document.body.appendChild(loadingOverlay);

                  setTimeout(() => {
                    window.location.href = "/my-bookings";
                  }, 2500);
                } else {
                  confirmationDiv.remove();
                  alert("Payment Verification Failed");
                  window.location.href = "/listings";
                }
            } catch (error) {
              console.log("Payment verification Failed", error);
              if(error.response && error.response.data && error.response.data.message){
                alert(error.response.data.message || "Something went wrong.");
              }
            }
          },
          "prefill": {
              "name": response.data.userDetails.username,
              "email": response.data.userDetails.email,
          },
          "notes": {
              "address": response.data.faradisetripCompany.address
          },
          "theme": {
              "color": "#00b3ffe4"
          }
      };

      var rzp1 = new Razorpay(options);
      rzp1.on('payment.failed', function (response){
              alert(`Payment failed-  ${response.error.description} | Reason - ${response.error.step}`);
              confirmationDiv.remove();
              bookNowBtn.disabled = false;
      });

      document.getElementById('rzp-button1').onclick = function(e){
          rzp1.open();
          e.preventDefault();
      }

      } catch(error){
        console.error(error);
        // Remove loading overlay on error
        const _blo = document.getElementById('bookingLoadingOverlay');
        if (_blo) _blo.remove();
        bookNowBtn.disabled = false;

        // If unauthenticated error
        if (error.response && (error.response.status === 401 || error.response.status === 302 || (typeof error.response.data === 'string' && error.response.data.includes('login')))) {
          window.location.href = "/login";
          return;
        }

        if(error.response){
          alert(error.response.data.message || "Booking failed. Please try again");
        }
        else if(error.request){
          alert("Server did not respond. Please try again.");
        }
        else {
          alert("Something went wrong.");
        }
      }
  });

} 

initializeBookingPage();

</script>
<script src="/dist/js/listingDisplayMap.bundle.js"></script>
<script>
  const ListingData = <%- JSON.stringify({
    id: ListingData.id,
    title: ListingData.title,
    description: ListingData.description,
    price: ListingData.price,
    location: ListingData.location,
    country: ListingData.country,
    image: { url: ListingData.image.url }
  }) %>;
</script>
<script src="/js/wishlistScript.js" ></script>